# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# PORT: The port the node server runs on (defaults to 3000)
PORT=3000

# FIREBASE CLIENT CONFIGURATION
# Set these when hosting this app on your own domain or hosting provider.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# FIREBASE ADMIN SERVICE ACCOUNT KEY (JSON STRING)
# Go to Firebase Console > Project Settings > Service Accounts and generate a new private key.
# Paste the JSON key string here to authorize server-side features.
# Alternatively, save the private key file in the root directory as "firebase-service-account.json"
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", ...}'
