rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // HELPER FUNCTIONS
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // The "Sovereign" - Ultimate authority
    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == "shamimrez22@gmail.com";
    }

    // Check if user is an active admin or the master admin
    function isAdmin() {
      return isMasterAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // ===============================================================
    // COLLECTION RULES
    // ===============================================================

    // Site Settings - Publicly readable, admin writable
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Layout Assets - Publicly readable, admin writable
    match /slider_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders - Private by default, Admin can see all, User can see own
    match /orders/{orderId} {
      allow create: if true; // Allow guest checkout or signed in
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin(); 
    }

    // Products - Publicly readable, admin writable
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons - Publicly readable, admin writable
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories - Publicly readable, admin writable
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications - Admin only
    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
